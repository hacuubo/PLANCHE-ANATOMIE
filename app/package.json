{
  "name": "coeur3d-app",
  "private": true,
  "version": "1.0.0",
  "description": "Applications iOS et Android de Cœur 3D (cardioexplain.com), enveloppe Capacitor du site",
  "type": "module",
  "scripts": {
    "www": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && npx cap sync",
    "android": "node scripts/build-www.mjs && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
